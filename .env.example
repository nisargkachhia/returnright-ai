# ReturnRight AI — copy to .env and adjust. No secrets required for demo.
DEMO_MODE=true
APP_NAME=ReturnRight AI
APP_ENV=development
# Fixed demo clock so hypothetical windows stay stable. ISO-8601.
POLICY_AS_OF=2026-10-23T12:00:00+00:00
LOG_LEVEL=INFO

# Demo identity (not production auth)
DEMO_USER_ID=demo-user-1
DEMO_USER_DISPLAY_NAME=Alex Demo

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DATABASE_URL=sqlite:///./data/returnright.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MCP_STATELESS_HTTP=true
MCP_JSON_RESPONSE=true

# Confirmation tokens
CONFIRMATION_TOKEN_TTL_SECONDS=900

# Frontend (Vite)
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_MCP_URL=http://127.0.0.1:8000/mcp
VITE_DEMO_MODE=true
